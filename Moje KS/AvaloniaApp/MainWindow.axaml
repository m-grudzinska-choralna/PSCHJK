<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:MojeKS.AvaloniaApp"
		x:Class="MojeKS.AvaloniaApp.MainWindow"
		Title="Okno Główne - Avalonia PoC"
		WindowStartupLocation="CenterScreen"
		Width="1000"
		Height="700">
  <DockPanel>
	<!-- Simple menu that maps to some top-level WinForms items as a PoC -->
	<Menu DockPanel.Dock="Top">
	  <MenuItem Header="Plik">
		<MenuItem Header="Rozpoznawanie nut" />
		<MenuItem Header="Rozpoznawanie symboli" />
	  </MenuItem>
	  <MenuItem Header="Materiały">
		<MenuItem Header="Tonacje" />
		<MenuItem Header="Nuty" />
	  </MenuItem>
	  <MenuItem Header="Edytor">
		<MenuItem Header="Edytor nut" />
	  </MenuItem>
	</Menu>

	<Grid RowDefinitions="Auto, *">
		<StackPanel Orientation="Horizontal" Margin="8">
		<TextBlock Text="{Binding TonacjaDisplay}" FontSize="16" VerticalAlignment="Center" />
	  </StackPanel>

	  <Border Grid.Row="1" Margin="8" BorderBrush="Gray" BorderThickness="1">
		<ScrollViewer>
		  <StackPanel Margin="8">
			<TextBlock Text="This is a minimal proof-of-concept port of OknoGlowne."/>
			<TextBlock Text="Original WinForms layout and custom drawing must be reimplemented manually."/>
			<local:OknoGlowne />
		  </StackPanel>
		</ScrollViewer>
	  </Border>
	</Grid>
  </DockPanel>
</Window>
