<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableLocalSigning Condition="'$(EnableLocalSigning)' == ''">true</EnableLocalSigning>
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
    <UseAppHost Condition="'$(Configuration)' != 'Debug'">true</UseAppHost>
    <PublishSingleFile Condition="'$(Configuration)' != 'Debug'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' != 'Debug'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
  </PropertyGroup>

  <Target Name="SignAvaloniaBinary" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(Configuration)' == 'Debug' and '$(EnableLocalSigning)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)SignApp.ps1&quot; &quot;$(TargetPath)&quot;" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="..\KS2\Resources\klucz__g.png" Link="Assets/klucz__g.png" />
    <AvaloniaResource Include="..\KS2\Resources\klucz_f.png" Link="Assets/klucz_f.png" />
    <AvaloniaResource Include="..\KS2\Resources\bemol.png" Link="Assets/bemol.png" />
    <AvaloniaResource Include="..\KS2\Resources\krzyzyk.png" Link="Assets/krzyzyk.png" />
    <AvaloniaResource Include="..\KS2\Resources\podwojny_bemol.png" Link="Assets/podwojny_bemol.png" />
    <AvaloniaResource Include="..\KS2\Resources\podwojny_krzyzyk.png" Link="Assets/podwojny_krzyzyk.png" />
    <AvaloniaResource Include="..\KS2\Resources\kasownik.png" Link="Assets/kasownik.png" />
    <AvaloniaResource Include="..\KS2\Resources\cala_nuta.png" Link="Assets/cala_nuta.png" />
    <AvaloniaResource Include="..\KS2\Resources\polnuta_w_gore.png" Link="Assets/polnuta_w_gore.png" />
    <AvaloniaResource Include="..\KS2\Resources\polnuta_w_dol.png" Link="Assets/polnuta_w_dol.png" />
    <AvaloniaResource Include="..\KS2\Resources\cwiercnuta_w_gore.png" Link="Assets/cwiercnuta_w_gore.png" />
    <AvaloniaResource Include="..\KS2\Resources\cwiercnuta_w_dol.png" Link="Assets/cwiercnuta_w_dol.png" />
    <AvaloniaResource Include="..\KS2\Resources\osemka_w_gore.png" Link="Assets/osemka_w_gore.png" />
    <AvaloniaResource Include="..\KS2\Resources\osemka_w_dol.png" Link="Assets/osemka_w_dol.png" />
    <AvaloniaResource Include="..\KS2\Resources\szesnastka_w_gore.png" Link="Assets/szesnastka_w_gore.png" />
    <AvaloniaResource Include="..\KS2\Resources\szesnastka_w_dol.png" Link="Assets/szesnastka_w_dol.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.0.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
