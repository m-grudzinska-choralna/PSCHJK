<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApp.ViewModels"
        xmlns:controls="using:AvaloniaApp.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1370"
        Height="770"
        MinWidth="900"
        MinHeight="600"
        Background="#EFF6FF">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="112,64,*" Margin="14">
        <Border Grid.Row="0" CornerRadius="22" Padding="24,12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#EAF3FF" Offset="0" />
                    <GradientStop Color="#C8DEFF" Offset="0.58" />
                    <GradientStop Color="#F5F9FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*">
                <Canvas Grid.Column="1" Width="760" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True">
                    <Path Data="M 0,66 C 135,-7 216,98 360,51 S 610,-3 760,42" Stroke="#70A9F5" StrokeThickness="3" />
                    <Path Data="M 0,77 C 135,4 216,109 360,62 S 610,8 760,53" Stroke="#397FD3" StrokeThickness="2.5" />
                    <Path Data="M 0,88 C 135,15 216,120 360,73 S 610,19 760,64" Stroke="#70A9F5" StrokeThickness="2.5" />
                    <Path Data="M 0,99 C 135,26 216,131 360,84 S 610,30 760,75" Stroke="#397FD3" StrokeThickness="2.5" />
                    <Path Data="M 0,110 C 135,37 216,142 360,95 S 610,41 760,86" Stroke="#70A9F5" StrokeThickness="2.5" />
                    <TextBlock Canvas.Left="150" Canvas.Top="30" Text="♫" FontFamily="Segoe UI Symbol" FontSize="39" FontWeight="Bold" Foreground="#123F7D" />
                    <TextBlock Canvas.Left="280" Canvas.Top="61" Text="♪" FontFamily="Segoe UI Symbol" FontSize="36" FontWeight="Bold" Foreground="#1556A5" />
                    <TextBlock Canvas.Left="426" Canvas.Top="18" Text="♫" FontFamily="Segoe UI Symbol" FontSize="42" FontWeight="Bold" Foreground="#123F7D" />
                    <TextBlock Canvas.Left="580" Canvas.Top="0" Text="♪" FontFamily="Segoe UI Symbol" FontSize="40" FontWeight="Bold" Foreground="#1556A5" />
                    <TextBlock Canvas.Left="680" Canvas.Top="35" Text="♪" FontFamily="Segoe UI Symbol" FontSize="36" FontWeight="Bold" Foreground="#1556A5" />
                </Canvas>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Image Source="avares://AvaloniaApp/Assets/klucz__g.png" Width="52" Height="82" Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Moje KS" FontSize="30" FontWeight="Bold" Foreground="#102A50" />
                        <TextBlock Text="Ćwiczenia muzyczne" FontSize="16" Foreground="#263B59" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="4,0">
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie nut"
                    FontSize="16" FontWeight="SemiBold" Foreground="White"
                    Background="#1257A8" BorderBrush="#1257A8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Width="26" Height="26" Fill="White" Data="M 12,2 L 1,12 H 4 V 22 H 9 V 15 H 15 V 22 H 20 V 12 H 23 Z" />
                    <TextBlock Text="Rozpoznawanie" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Tonacje"
                    FontSize="16" FontWeight="SemiBold" Foreground="#183B6A"
                    Background="#F8FBFF" BorderBrush="#D5E4F8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Grid Width="27" Height="26">
                        <Path Data="M 2,4 C 6,2 10,3 13,6 C 16,3 20,2 25,4 V 22 C 20,20 16,20 13,23 C 10,20 6,20 2,22 Z"
                              Stroke="#183B6A" StrokeThickness="2.4" StrokeLineCap="Round" />
                        <Path Data="M 13,6 V 23" Stroke="#183B6A" StrokeThickness="2.2" />
                    </Grid>
                    <TextBlock Text="Materiały" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Losowe nuty"
                    FontSize="16" FontWeight="SemiBold" Foreground="#183B6A"
                    Background="#F8FBFF" BorderBrush="#D5E4F8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Grid Width="27" Height="27">
                        <Border CornerRadius="5" BorderBrush="#183B6A" BorderThickness="2.5" />
                        <Canvas>
                            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="17" Canvas.Top="5" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="11" Canvas.Top="11" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="5" Canvas.Top="17" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="17" Canvas.Top="17" Width="5" Height="5" Fill="#183B6A" />
                        </Canvas>
                    </Grid>
                    <TextBlock Text="Losowe" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Edytor nut"
                    FontSize="16" FontWeight="SemiBold" Foreground="#183B6A"
                    Background="#F8FBFF" BorderBrush="#D5E4F8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Width="26" Height="26" Fill="#183B6A"
                          Data="M 3,18 L 17,4 L 22,9 L 8,23 L 2,24 Z M 15,6 L 20,11" />
                    <TextBlock Text="Edytor" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="286,*" Margin="4,4,0,0">
            <Border Grid.Column="0" Margin="0,0,14,0" Background="#FBFCFF" BorderBrush="#DFE9F7" BorderThickness="1"
                    CornerRadius="22" Padding="18" BoxShadow="0 5 14 0 #304B78">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="11">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#E5EFFD">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="#164D90"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Opcje ćwiczenia" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Pokaż odpowiedź" IsChecked="{Binding ShowAnswers}" FontSize="16" Margin="4,0" />
                        <CheckBox Content="Kolejne pytania" FontSize="16" Margin="4,0" />

                        <TextBlock Text="Klucz ćwiczenia" FontSize="16" FontWeight="Bold" Margin="4,2,0,0" />
                        <StackPanel Spacing="4">
                            <RadioButton Content="Wiolinowy" GroupName="ExerciseClef"
                                         IsChecked="{Binding IsTrebleClefSelected, Mode=TwoWay}" FontSize="16" />
                            <RadioButton Content="Basowy" GroupName="ExerciseClef"
                                         IsChecked="{Binding IsBassClefSelected, Mode=TwoWay}" FontSize="16" />
                        </StackPanel>

                        <Separator Margin="0,2" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#E5EFFD">
                                <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="#164D90"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Zakres nut" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsTrebleClefSelected}" Spacing="6">
                            <TextBlock Text="Wiolinowy: od — do" FontSize="15" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox Width="125" ItemsSource="{Binding TrebleNotes}" SelectedItem="{Binding TrebleFrom}" />
                                <ComboBox Width="125" ItemsSource="{Binding TrebleNotes}" SelectedItem="{Binding TrebleTo}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBassClefSelected}" Spacing="6">
                            <TextBlock Text="Basowy: od — do" FontSize="15" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox Width="125" ItemsSource="{Binding BassNotes}" SelectedItem="{Binding BassFrom}" />
                                <ComboBox Width="125" ItemsSource="{Binding BassNotes}" SelectedItem="{Binding BassTo}" />
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,2" />
                        <Button Command="{Binding GenerateNewNoteCommand}" Content="▶   Rozpocznij"
                                FontSize="18" FontWeight="SemiBold" Foreground="White" Background="#0868C8"
                                BorderBrush="#0868C8" BorderThickness="1" CornerRadius="28" Padding="16,12" />
                        <TextBlock Text="♫   ♬" FontFamily="Segoe UI Symbol" FontSize="25" Foreground="#438FE4"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#FFFEFC" BorderBrush="#C7DDFB" BorderThickness="2"
                    CornerRadius="24" Padding="22" BoxShadow="0 6 16 0 #405A86">
                <Grid>
                    <controls:StaffCanvas Clef="{Binding CurrentQuestion.Clef}"
                                          Note="{Binding CurrentQuestion.Note}"
                                          Answer="{Binding CurrentQuestion.Answer}"
                                          ShowAnswers="{Binding ShowAnswers}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                            Background="#DFECFF" CornerRadius="24" Padding="18,6">
                        <TextBlock Text="{Binding SymbolicNote}" FontSize="48" FontWeight="Bold" Foreground="#123F7D" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
