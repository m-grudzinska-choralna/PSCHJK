<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApp.ViewModels"
        xmlns:controls="using:AvaloniaApp.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        MinWidth="900"
        MinHeight="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Rozpoznawanie">
                <MenuItem Header="Nut" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie nut" />
                <MenuItem Header="Symboli" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie symboli" />
                <MenuItem Header="Klawiszy" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie klawiszy" />
                <MenuItem Header="Interwałów" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie interwałów" />
            </MenuItem>
            <MenuItem Header="Materiały">
                <MenuItem Header="Tonacje" Command="{Binding SelectExerciseCommand}" CommandParameter="Tonacje" />
            </MenuItem>
            <MenuItem Header="Losowe">
                <MenuItem Header="Nuty" Command="{Binding SelectExerciseCommand}" CommandParameter="Losowe nuty" />
                <MenuItem Header="Interwały" Command="{Binding SelectExerciseCommand}" CommandParameter="Losowe interwały" />
            </MenuItem>
            <MenuItem Header="Edytor">
                <MenuItem Header="Nut" Command="{Binding SelectExerciseCommand}" CommandParameter="Edytor nut" />
                <MenuItem Header="Interwałów" Command="{Binding SelectExerciseCommand}" CommandParameter="Edytor interwałów" />
            </MenuItem>
        </Menu>

        <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,*" Margin="12">
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#EAF2FF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Moje KS" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Ćwiczenia muzyczne" Foreground="#475569" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <CheckBox Content="Pokaż odpowiedzi" IsChecked="{Binding ShowAnswers}" />
                        <CheckBox Content="Kolejne pytania" />
                        <TextBlock Text="Klucz ćwiczenia" FontSize="16" FontWeight="Bold" />
                        <StackPanel Spacing="4">
                            <RadioButton Content="Wiolinowy" GroupName="ExerciseClef"
                                         IsChecked="{Binding IsTrebleClefSelected, Mode=TwoWay}" />
                            <RadioButton Content="Basowy" GroupName="ExerciseClef"
                                         IsChecked="{Binding IsBassClefSelected, Mode=TwoWay}" />
                        </StackPanel>
                        <Separator />
                        <TextBlock Text="Zakres nut" FontSize="16" FontWeight="Bold" />
                        <StackPanel IsVisible="{Binding IsTrebleClefSelected}" Spacing="4">
                            <TextBlock Text="Wiolinowy: od — do" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox Width="125" ItemsSource="{Binding TrebleNotes}" SelectedItem="{Binding TrebleFrom}" />
                                <ComboBox Width="125" ItemsSource="{Binding TrebleNotes}" SelectedItem="{Binding TrebleTo}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBassClefSelected}" Spacing="4">
                            <TextBlock Text="Basowy: od — do" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox Width="125" ItemsSource="{Binding BassNotes}" SelectedItem="{Binding BassFrom}" />
                                <ComboBox Width="125" ItemsSource="{Binding BassNotes}" SelectedItem="{Binding BassTo}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid>
                    <controls:StaffCanvas Clef="{Binding CurrentQuestion.Clef}"
                                           Note="{Binding CurrentQuestion.Note}"
                                           Answer="{Binding CurrentQuestion.Answer}"
                                           ShowAnswers="{Binding ShowAnswers}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <TextBlock Text="{Binding SymbolicNote}" FontSize="72" FontWeight="Bold" Foreground="Blue"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,64,0" />
                </Grid>
            </Border>

        </Grid>
    </DockPanel>

</Window>
