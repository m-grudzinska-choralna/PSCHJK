<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApp.ViewModels"
        xmlns:controls="using:AvaloniaApp.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        MinWidth="900"
        MinHeight="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Rozpoznawanie">
                <MenuItem Header="Nut" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie nut" />
                <MenuItem Header="Symboli" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie symboli" />
                <MenuItem Header="Klawiszy" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie klawiszy" />
                <MenuItem Header="Interwałów" Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie interwałów" />
            </MenuItem>
            <MenuItem Header="Materiały">
                <MenuItem Header="Tonacje" Command="{Binding SelectExerciseCommand}" CommandParameter="Tonacje" />
            </MenuItem>
            <MenuItem Header="Losowe">
                <MenuItem Header="Nuty" Command="{Binding SelectExerciseCommand}" CommandParameter="Losowe nuty" />
                <MenuItem Header="Interwały" Command="{Binding SelectExerciseCommand}" CommandParameter="Losowe interwały" />
            </MenuItem>
            <MenuItem Header="Edytor">
                <MenuItem Header="Nut" Command="{Binding SelectExerciseCommand}" CommandParameter="Edytor nut" />
                <MenuItem Header="Interwałów" Command="{Binding SelectExerciseCommand}" CommandParameter="Edytor interwałów" />
            </MenuItem>
        </Menu>

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="280,*,260" Margin="12">
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#EAF2FF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Moje KS" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Interfejs Avalonia — baza migracji" Foreground="#475569" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding IsParameterPanelExpanded, StringFormat='Panel parametrów: {0}'}"
                            Command="{Binding ToggleParameterPanelCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" IsVisible="{Binding IsParameterPanelExpanded}"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Parametry ćwiczenia" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Tryb" />
                        <ComboBox ItemsSource="{Binding ExerciseModes}" SelectedItem="{Binding SelectedExercise}" />
                        <CheckBox Content="Pokaż odpowiedzi" IsChecked="{Binding ShowAnswers}" />
                        <CheckBox Content="Kolejne pytania" />
                        <Separator />
                        <TextBlock Text="Zakres nut" FontSize="16" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding Clefs}" SelectedItem="{Binding SelectedClef}" />
                        <TextBlock Text="Wiolinowy: od — do" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox Width="85" ItemsSource="{Binding Notes}" SelectedItem="{Binding TrebleFrom}" />
                            <ComboBox Width="85" ItemsSource="{Binding Notes}" SelectedItem="{Binding TrebleTo}" />
                        </StackPanel>
                        <TextBlock Text="Basowy: od — do" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox Width="85" ItemsSource="{Binding Notes}" SelectedItem="{Binding BassFrom}" />
                            <ComboBox Width="85" ItemsSource="{Binding Notes}" SelectedItem="{Binding BassTo}" />
                        </StackPanel>
                        <Button Content="Zastosuj zakres" Command="{Binding ApplyNoteRangeCommand}" />
                        <TextBlock Text="{Binding NoteRangeStatus}" TextWrapping="Wrap" Foreground="#475569" />
                        <Separator />
                        <TextBlock Text="Ustawienia zostaną podłączone do modelu domenowego w kolejnych krokach."
                                   TextWrapping="Wrap" Foreground="#64748B" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Obszar arkusza muzycznego" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <controls:StaffCanvas Clef="{Binding CurrentQuestion.Clef}"
                                           Note="{Binding CurrentQuestion.Note}"
                                           Answer="{Binding CurrentQuestion.Answer}"
                                           ShowAnswers="{Binding ShowAnswers}"
                                           HorizontalAlignment="Stretch" />
                    <TextBlock Text="Zakres nut jest renderowany przez natywny kontroler Avalonia."
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="12,0,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nawigacja" FontSize="18" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Wstecz" Command="{Binding GoPreviousCommand}" />
                        <Button Content="Dalej" Command="{Binding GoNextCommand}" />
                    </StackPanel>
                    <Separator />
                    <TextBlock Text="Aktualny tryb" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedExercise}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentRound, StringFormat='Runda: {0}'}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#F8FAFC" Padding="10" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" />
            </Border>
        </Grid>
    </DockPanel>

</Window>
