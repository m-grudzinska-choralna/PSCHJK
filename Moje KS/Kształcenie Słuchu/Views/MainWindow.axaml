<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KsztalcenieSluchu.ViewModels"
        xmlns:controls="using:KsztalcenieSluchu.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="KsztalcenieSluchu.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        Width="1370"
        Height="980"
        WindowStartupLocation="CenterScreen"
        MinWidth="900"
        MinHeight="600"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border CornerRadius="16" ClipToBounds="True" Background="#EFF6FF">
    <Grid RowDefinitions="44,112,64,*" Margin="8,0,8,8">
        <Border Grid.Row="0" Background="#1257A8" CornerRadius="0" Margin="-8,0,-8,6"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid>
            <TextBlock Text="{Binding WindowTitle}" Foreground="White"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="OnMinimizeClick" ToolTip.Tip="Minimalizuj"
                        Width="44" Height="40" Padding="0" Foreground="White"
                        Background="Transparent" BorderThickness="0">
                    <Rectangle Width="13" Height="2" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnMaximizeClick" ToolTip.Tip="Maksymalizuj"
                        Width="44" Height="40" Padding="0" Foreground="White"
                        Background="Transparent" BorderThickness="0">
                    <Rectangle Width="13" Height="13" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnCloseClick" ToolTip.Tip="Zamknij"
                        Width="44" Height="40" Padding="0" Foreground="White"
                        Background="Transparent" BorderThickness="0">
                    <Path Data="M0,0 L13,13 M13,0 L0,13" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" CornerRadius="22" Padding="24,12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#EAF3FF" Offset="0" />
                    <GradientStop Color="#C8DEFF" Offset="0.58" />
                    <GradientStop Color="#F5F9FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*">
                <Viewbox Grid.ColumnSpan="2" Stretch="Fill" Height="112" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Canvas Width="1300" Height="112">
                        <Path Data="M 0,0 H 1300 V 26 C 1168,8 1068,40 946,24 S 700,40 560,24 S 288,40 0,20 Z" Fill="#F7FBFF" />
                        <Path Data="M 0,112 V 64 C 94,36 186,96 308,68 S 534,72 690,62 S 934,84 1128,60 S 1236,70 1300,62 V 112 Z" Fill="#CFE4FF" Opacity="0.9" />
                        <Path Data="M 250,20 C 328,-18 422,74 510,28 S 702,-12 802,32 S 992,0 1300,20" Stroke="#88C0FF" StrokeThickness="3.2" StrokeLineCap="Round" />
                        <Path Data="M 250,32 C 328,-6 422,86 510,40 S 702,0 802,44 S 992,12 1300,32" Stroke="#73B0FF" StrokeThickness="3.2" StrokeLineCap="Round" />
                        <Path Data="M 250,44 C 328,6 422,98 510,52 S 702,12 802,56 S 992,24 1300,44" Stroke="#5EA2FA" StrokeThickness="3.2" StrokeLineCap="Round" />
                        <Path Data="M 250,56 C 328,18 422,110 510,64 S 702,24 802,68 S 992,36 1300,56" Stroke="#4B94F0" StrokeThickness="3.2" StrokeLineCap="Round" />
                        <Path Data="M 250,68 C 328,30 422,122 510,76 S 702,36 802,80 S 992,48 1300,68" Stroke="#3A84E2" StrokeThickness="3.2" StrokeLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Canvas Grid.ColumnSpan="2" Height="112" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True">
                    <Path Data="M 0,0 H 520 C 488,24 456,40 432,62 C 402,88 338,108 244,112 H 0 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#EFF6FF" Offset="0" />
                                <GradientStop Color="#EFF6FF" Offset="0.76" />
                                <GradientStop Color="#00EFF6FF" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Canvas>
                <Grid Grid.ColumnSpan="2" Height="112" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"
                      ColumnDefinitions="444*,Auto,196*,Auto,140*,Auto,122*,Auto,166*,Auto">
                    <TextBlock Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Top" Text="♪" FontFamily="Segoe UI Symbol" FontSize="46" FontWeight="Bold" Foreground="#0A3F86" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="-11" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Grid.Column="3" Margin="0,28,0,0" VerticalAlignment="Top" Text="♩" FontFamily="Segoe UI Symbol" FontSize="50" FontWeight="Bold" Foreground="#0E4B95" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="-8" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Grid.Column="5" Margin="0,22,0,0" VerticalAlignment="Top" Text="♫" FontFamily="Segoe UI Symbol" FontSize="48" FontWeight="Bold" Foreground="#0C4590" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="-4" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Grid.Column="7" Margin="0,8,0,0" VerticalAlignment="Top" Text="♪" FontFamily="Segoe UI Symbol" FontSize="46" FontWeight="Bold" Foreground="#1458A5" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="7" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Grid.Column="9" Margin="0,20,0,0" VerticalAlignment="Top" Text="♩" FontFamily="Segoe UI Symbol" FontSize="44" FontWeight="Bold" Foreground="#165FAF" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="9" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Image Source="avares://KsztalcenieSluchu/Assets/klucz__g.png" Width="52" Height="82" Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Moje KS" FontSize="30" FontWeight="Bold" Foreground="#102A50" />
                        <TextBlock Text="Ćwiczenia muzyczne" FontSize="16" Foreground="#263B59" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="4,0">
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Rozpoznawanie nut"
                    FontSize="16" FontWeight="SemiBold" Foreground="White"
                    Background="#1257A8" BorderBrush="#1257A8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Width="26" Height="26" Fill="White" Data="M 12,2 L 1,12 H 4 V 22 H 9 V 15 H 15 V 22 H 20 V 12 H 23 Z" />
                    <TextBlock Text="Rozpoznawanie" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Tonacje" IsVisible="{Binding !IsStudentMode}"
                    FontSize="16" FontWeight="SemiBold" Foreground="#183B6A"
                    Background="#F8FBFF" BorderBrush="#D5E4F8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Grid Width="27" Height="26">
                        <Path Data="M 2,4 C 6,2 10,3 13,6 C 16,3 20,2 25,4 V 22 C 20,20 16,20 13,23 C 10,20 6,20 2,22 Z"
                              Stroke="#183B6A" StrokeThickness="2.4" StrokeLineCap="Round" />
                        <Path Data="M 13,6 V 23" Stroke="#183B6A" StrokeThickness="2.2" />
                    </Grid>
                    <TextBlock Text="Materiały" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Losowe nuty" IsVisible="{Binding !IsStudentMode}"
                    FontSize="16" FontWeight="SemiBold" Foreground="#183B6A"
                    Background="#F8FBFF" BorderBrush="#D5E4F8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Grid Width="27" Height="27">
                        <Border CornerRadius="5" BorderBrush="#183B6A" BorderThickness="2.5" />
                        <Canvas>
                            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="17" Canvas.Top="5" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="11" Canvas.Top="11" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="5" Canvas.Top="17" Width="5" Height="5" Fill="#183B6A" />
                            <Ellipse Canvas.Left="17" Canvas.Top="17" Width="5" Height="5" Fill="#183B6A" />
                        </Canvas>
                    </Grid>
                    <TextBlock Text="Losowe" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectExerciseCommand}" CommandParameter="Edytor nut" IsVisible="{Binding !IsStudentMode}"
                    FontSize="16" FontWeight="SemiBold" Foreground="#183B6A"
                    Background="#F8FBFF" BorderBrush="#D5E4F8" BorderThickness="1" CornerRadius="28" Padding="22,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Width="26" Height="26" Fill="#183B6A"
                          Data="M 3,18 L 17,4 L 22,9 L 8,23 L 2,24 Z M 15,6 L 20,11" />
                    <TextBlock Text="Edytor" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="286,*" Margin="4,4,0,0">
            <Border Grid.Column="0" Margin="0,0,14,0" Background="#FBFCFF" BorderBrush="#DFE9F7" BorderThickness="1"
                    CornerRadius="22" Padding="18" BoxShadow="0 5 14 0 #304B78">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="11" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#E5EFFD">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="#164D90"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Opcje" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Pokaż kolejno" IsChecked="{Binding ShowSequential}" FontSize="16" Margin="4,0" />

                        <TextBlock Text="Nazwy nut" FontSize="16" FontWeight="Bold" Margin="4,2,0,0" />
                        <StackPanel Spacing="4">
                            <RadioButton Content="Nie pokazuj" GroupName="NoteNames"
                                         IsChecked="{Binding IsNoNamesSelected, Mode=TwoWay}" FontSize="16" />
                            <RadioButton Content="Nazwy literowe"
                                         IsChecked="{Binding IsLetterNamesSelected, Mode=TwoWay}" FontSize="16" />
                            <RadioButton Content="Nazwy pełne" GroupName="NoteNames"
                                         IsChecked="{Binding IsFullNamesSelected, Mode=TwoWay}" FontSize="16" />
                            <RadioButton Content="Nazwy solmizacyjne"
                                         IsChecked="{Binding IsSolmizationNamesSelected, Mode=TwoWay}" FontSize="16" />
                        </StackPanel>

                        <TextBlock Text="Znaki chromatyczne" FontSize="16" FontWeight="Bold" Margin="4,2,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsNoAccidentalSelected, Mode=TwoWay}"></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsFlatSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/bemol.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsSharpSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/krzyzyk.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsDoubleFlatSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/podwojny_bemol.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsDoubleSharpSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/podwojny_krzyzyk.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                        </StackPanel>

                        <TextBlock Text="Wartości rytmiczne" FontSize="16" FontWeight="Bold" Margin="4,2,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsWholeNoteSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/cala_nuta.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsHalfNoteSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/polnuta_w_gore.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsQuarterNoteSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/cwiercnuta_w_gore.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsEighthNoteSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/osemka_w_gore.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                            <ToggleButton Width="30" Height="30" Padding="0" IsChecked="{Binding IsSixteenthNoteSelected, Mode=TwoWay}"><Image Source="avares://KsztalcenieSluchu/Assets/szesnastka_w_gore.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></ToggleButton>
                        </StackPanel>
                        <TextBlock Text="Klucz" FontSize="16" FontWeight="Bold" Margin="4,2,0,0" />
                        <StackPanel Spacing="4">
                            <RadioButton Content="Wiolinowy" GroupName="ExerciseClef"
                                         IsChecked="{Binding IsTrebleClefSelected, Mode=TwoWay}" FontSize="16" />
                            <RadioButton Content="Basowy" GroupName="ExerciseClef"
                                         IsChecked="{Binding IsBassClefSelected, Mode=TwoWay}" FontSize="16" />
                        </StackPanel>

                        <TextBlock Text="ZAKRES" FontSize="11" FontWeight="SemiBold" Foreground="#5B6B85" Margin="4,6,0,0" />
                        <ComboBox HorizontalAlignment="Stretch" FontSize="14" ItemsSource="{Binding RangePresets}"
                                  SelectedItem="{Binding SelectedRangePreset}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RangePresetOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border IsVisible="{Binding IsPresetRangeSelected}" Background="#F3F7FD" BorderBrush="#DFE9F7" BorderThickness="1"
                                CornerRadius="10" Padding="12,9">
                            <TextBlock Text="{Binding SelectedRangeText}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel IsVisible="{Binding IsTrebleCustomRange}" Spacing="6">
                            <TextBlock Text="OD" FontSize="11" FontWeight="SemiBold" Foreground="#5B6B85" Margin="4,0,0,0" />
                            <ComboBox HorizontalAlignment="Stretch" FontSize="14" ItemsSource="{Binding TrebleNotes}" SelectedItem="{Binding TrebleFrom}" />
                            <TextBlock Text="DO" FontSize="11" FontWeight="SemiBold" Foreground="#5B6B85" Margin="4,0,0,0" />
                            <ComboBox HorizontalAlignment="Stretch" FontSize="14" ItemsSource="{Binding TrebleNotes}" SelectedItem="{Binding TrebleTo}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBassCustomRange}" Spacing="6">
                            <TextBlock Text="OD" FontSize="11" FontWeight="SemiBold" Foreground="#5B6B85" Margin="4,0,0,0" />
                            <ComboBox HorizontalAlignment="Stretch" FontSize="14" ItemsSource="{Binding BassNotes}" SelectedItem="{Binding BassFrom}" />
                            <TextBlock Text="DO" FontSize="11" FontWeight="SemiBold" Foreground="#5B6B85" Margin="4,0,0,0" />
                            <ComboBox HorizontalAlignment="Stretch" FontSize="14" ItemsSource="{Binding BassNotes}" SelectedItem="{Binding BassTo}" />
                        </StackPanel>

                        <Separator Margin="0,2" />
                        <TextBlock Text="♫   ♬" FontFamily="Segoe UI Symbol" FontSize="25" Foreground="#438FE4"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#FFFEFC" BorderBrush="#C7DDFB" BorderThickness="2"
                    CornerRadius="24" Padding="22" BoxShadow="0 6 16 0 #405A86">
                <Grid>
                    <controls:StaffCanvas Rhythm="{Binding CurrentQuestion.NoteData.RhythmicValue.Name}"
                                                              Clef="{Binding CurrentQuestion.Clef}"
                                          Note="{Binding CurrentQuestion.Note}"
                                          Answer="{Binding CurrentQuestion.Answer}"
                                          Accidental="{Binding CurrentQuestion.Accidental}"
                                          ShowAnswers="{Binding IsAnswerVisible}"
                                          UseLetterNames="{Binding UseLetterNames}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                            IsVisible="{Binding IsAnswerVisible}"
                            Background="#DFECFF" CornerRadius="24" Padding="18,6">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SymbolicNote}" FontSize="{Binding SymbolicNoteFontSize}"
                                           HorizontalAlignment="Center" />
                                <Border Grid.Row="1" Height="4" CornerRadius="2" Background="#123F7D" HorizontalAlignment="Stretch"
                                        Margin="0,-7,0,0"
                                        IsVisible="{Binding HasFirstLowLine}" />
                                <Border Grid.Row="2" Height="4" CornerRadius="2" Background="#123F7D" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding HasSecondLowLine}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
    </Border>
</Window>
